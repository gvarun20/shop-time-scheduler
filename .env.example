DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/postgres?sslmode=require"
AUTH_SECRET="replace-with-a-long-random-string"

# WhatsApp via Twilio (https://www.twilio.com/docs/whatsapp)
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_WHATSAPP_FROM="whatsapp:+14155238886"

# Protect cron endpoint (Vercel Cron sends Authorization: Bearer <CRON_SECRET> if set in project)
CRON_SECRET="replace-with-random-secret"

# Shop local time offset used for 2-hour reminders (e.g. Netherlands summer = +02:00)
SHOP_UTC_OFFSET="+02:00"
